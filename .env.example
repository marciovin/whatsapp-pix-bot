# ===== Aplicação =====
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Número de proxies reversos na frente da app (0 = nenhum; 1 atrás de nginx/Cloudflare tunnel etc.)
TRUST_PROXY=0

# ===== Banco (PostgreSQL) =====
# Usado pelo docker-compose para criar o banco local
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
POSTGRES_DB=whatsapp_bot
# App rodando FORA do Docker (npm run dev). Dentro do compose, a URL é montada automaticamente.
DATABASE_URL=postgresql://bot:bot@localhost:5432/whatsapp_bot?schema=public

# ===== Negócio =====
STORE_NAME=Minha Loja
# Número do responsável que recebe o resumo (DDI+DDD+número, só dígitos)
OWNER_WHATSAPP_NUMBER=5500000000000

# ===== WhatsApp Cloud API (Meta) =====
WHATSAPP_ACCESS_TOKEN=COLE_O_TOKEN_PERMANENTE_AQUI
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Texto aleatório que VOCÊ inventa (mín. 16 caracteres); o mesmo valor vai no painel da Meta
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-aleatorio-longo
WHATSAPP_APP_SECRET=COLE_O_APP_SECRET_DO_APP_DA_META
WHATSAPP_API_VERSION=v21.0
# Opcional: template aprovado (1 variável {{1}}) para avisar o responsável fora da janela de 24h
OWNER_NOTIFY_TEMPLATE=
OWNER_NOTIFY_TEMPLATE_LANG=pt_BR

# ===== Asaas =====
ASAAS_API_KEY=COLE_A_CHAVE_DE_API_AQUI
# sandbox | production
ASAAS_ENV=sandbox
# Token que você inventa (mín. 32 caracteres); o mesmo valor vai no cadastro do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-aleatorio-com-32-ou-mais-caracteres

# ===== Outbox (reenvio de mensagens) =====
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=10
